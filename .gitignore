# Compiled Java files
*.class

# Trusted instructor-provided bytecode (DataException, Shape, Circle, Rectangle)
!assessment/resources/**/*.class

# Generated content
output/*
workspace/*
workspaces/
temp_workspaces/
extracted/
generated_submissions/
classes/*
test-classes/

# Keep empty scaffold folders in Git
!output/.gitkeep
!workspace/.gitkeep
!classes/.gitkeep

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Student submissions
submissions/*
!submissions/.gitkeep